cx q[2],q[4];
cx q[4],q[2];
cx q[2],q[4];
cx q[1],q[4];
rz(2.527058471368) q[4];
cx q[1],q[4];
cx q[3],q[5];
rz(2.527058471368) q[5];
cx q[3],q[5];
