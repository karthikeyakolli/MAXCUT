rz(pi/2) q[1];
sx q[1];
rz(-2.254981661687) q[1];
sx q[1];
rz(pi/2) q[1];
rz(pi/2) q[2];
sx q[2];
rz(-2.254981661687) q[2];
sx q[2];
rz(pi/2) q[2];
